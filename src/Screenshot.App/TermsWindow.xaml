<Window x:Class="Screenshot.App.TermsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="Assets/Screenshot.ico" Title="Screenshot · 使用条款" Width="860" Height="690" MinWidth="620" MinHeight="460" WindowStartupLocation="CenterScreen" Background="{DynamicResource ClayCanvas}" Foreground="{DynamicResource ClayInk}" ResizeMode="CanResize">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12"><TextBlock FontSize="22" FontWeight="SemiBold" Text="Screenshot 使用条款"/><TextBlock x:Name="Summary" Margin="0,8,0,0" TextWrapping="Wrap" Text="请阅读使用条款和随附第三方许可。选择同意前，截图、剪贴板、全局热键和云端功能均未启动。"/></StackPanel>
    <ComboBox x:Name="DocumentList" Grid.Row="1" Margin="0,0,0,10" DisplayMemberPath="Title" SelectionChanged="OnDocumentChanged" AutomationProperties.Name="条款及第三方许可文档"/>
    <Grid Grid.Row="2"><TextBox x:Name="PlainText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12" FontSize="14" AutomationProperties.Name="条款原文"/><RichTextBox x:Name="RichText" IsReadOnly="True" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="12" FontSize="14" AutomationProperties.Name="SDK许可原文"/></Grid>
    <CheckBox x:Name="Consent" Grid.Row="3" Margin="0,14,0,8" Checked="OnConsentChanged" Unchecked="OnConsentChanged"><TextBlock TextWrapping="Wrap" Text="我已阅读并同意《Screenshot 使用条款》，并已获提供适用的第三方许可及 Windows SDK 组件使用限制。"/></CheckBox>
    <TextBlock x:Name="ErrorText" Grid.Row="4" TextWrapping="Wrap" Foreground="#A63D2B" Margin="0,0,0,8"/>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ExitButton" Content="不同意并退出" Padding="18,8" Margin="0,0,10,0" IsCancel="True"/><Button x:Name="ContinueButton" Content="同意并继续" Padding="18,8" IsEnabled="False" Click="OnAccept"/></StackPanel>
  </Grid>
</Window>
