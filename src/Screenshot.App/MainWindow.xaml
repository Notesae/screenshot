<Window x:Class="Screenshot.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" xmlns:local="clr-namespace:Screenshot.App" Icon="Assets/Screenshot.ico" Title="Screenshot · 截图编辑" Width="1100" Height="760" MinWidth="640" MinHeight="480" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" BorderThickness="0" Background="{DynamicResource ClayCanvas}" FontFamily="{DynamicResource ClayFont}" Foreground="{DynamicResource ClayInk}">
  <Grid ClipToBounds="True">
    <local:FrozenBackdropSurface x:Name="FrozenBackdrop" Visibility="Collapsed" />
    <DockPanel>
      <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="{DynamicResource ClaySurface}" Padding="14,5"><DockPanel><Button DockPanel.Dock="Right" Content="使用条款" Padding="10,0" Margin="12,0,0,0" Click="ShowTerms"/><Button DockPanel.Dock="Right" Content="重试加载" Margin="8,0" Click="RetryEditor"/><Button DockPanel.Dock="Right" Content="区域截图" Margin="8,0" Click="StartCapture"/><TextBlock x:Name="Status" Text="正在启动本地编辑器…" Foreground="{DynamicResource ClayInk}" FontSize="12" TextTrimming="CharacterEllipsis" /></DockPanel></Border>
      <wv:WebView2CompositionControl x:Name="Editor" />
    </DockPanel>
  </Grid>
</Window>
