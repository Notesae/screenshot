<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Screenshot</AssemblyName><Version>0.4.7</Version><Copyright>© 2026 Notesae</Copyright>
    <!-- 用户提供的公开 Client ID，不是 secret；显式空的全局构建参数可禁用。 -->
    <ScreenshotGitHubClientId Condition="'$(ScreenshotGitHubClientId)' == ''">Iv23lisFgrPOh81NM4nz</ScreenshotGitHubClientId>
  </PropertyGroup>
  <ItemGroup>
    <!-- 仅嵌入用户确认的公开应用标识；令牌仍仅在原生内存，构建参数不接受 secret/token。 -->
    <AssemblyMetadata Include="GitHubUpdateClientId" Value="$(ScreenshotGitHubClientId)" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
    <ProjectReference Include="../Screenshot.AI/Screenshot.AI.csproj" />
    <ProjectReference Include="../Screenshot.Ocr/Screenshot.Ocr.csproj" />
    <ProjectReference Include="../Screenshot.Storage/Screenshot.Storage.csproj" />
    <Content Include="../../editor/dist/**/*"><Link>web/%(RecursiveDir)%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content>
    <Content Include="../../models/pp-ocrv5-mobile/*"><Link>models/pp-ocrv5-mobile/%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content>
    <Content Include="../../scripts/diagnose-portable.ps1"><Link>diagnose-portable.ps1</Link><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content>
    <Content Include="../../THIRD-PARTY-NOTICES.md"><Link>THIRD-PARTY-NOTICES.md</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content>
    <Content Include="../../legal/*"><Link>legal/%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content>
    <Content Include="../../licenses/*"><Link>licenses/%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content>
  </ItemGroup>
  <!-- WindowsDesktop 引用由 SDK 后导入；执行阶段仅固定 .NET 运行时，不污染 Windows SDK 制品版本。 -->
  <Target Name="PinScreenshotRuntimeFrameworks" BeforeTargets="ProcessFrameworkReferences" Condition="'$(ScreenshotRuntimeVersion)' != ''">
    <ItemGroup>
      <FrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App;Microsoft.WindowsDesktop.App.WPF;Microsoft.WindowsDesktop.App.WindowsForms" RuntimeFrameworkVersion="$(ScreenshotRuntimeVersion)" />
      <KnownAppHostPack Update="Microsoft.NETCore.App" Condition="'%(KnownAppHostPack.TargetFramework)' == 'net10.0'" AppHostPackVersion="$(ScreenshotRuntimeVersion)" />
    </ItemGroup>
  </Target>
</Project>
