<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Screenshot.App">
  <!-- 所有应用窗口共用无描边模板；焦点只叠加柔和底色，不改变控件占位。 -->
  <Style x:Key="ClayControl" TargetType="Control">
    <Setter Property="FontFamily" Value="{DynamicResource ClayFont}"/>
    <Setter Property="FontSize" Value="{DynamicResource ClayBodySize}"/>
    <Setter Property="Foreground" Value="{DynamicResource ClayInk}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <Style x:Key="ClayFloatingSurface" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource ClaySurface}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ClayFloatingRadius}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="local:SoftClaySurface.Material" Value="Floating"/>
    <Setter Property="Effect" Value="{DynamicResource ClayShadow}"/>
  </Style>
  <Style x:Key="ClayButton" TargetType="Button" BasedOn="{StaticResource ClayControl}">
    <Setter Property="MinHeight" Value="{DynamicResource ClayControlHeight}"/>
    <Setter Property="Padding" Value="12,9"/>
    <Setter Property="Background" Value="{DynamicResource ClayRaised}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="local:SoftClaySurface.Material" Value="Raised"/>
    <Setter Property="Effect" Value="{DynamicResource ClayButtonShadow}"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <!-- 透明根网格保持命中区域；材质和图文各自运动。 -->
      <Grid Background="Transparent">
        <local:SoftClaySurface x:Name="Face" IsHitTestVisible="False" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ClayControlRadius}"
                BorderThickness="0" Material="{Binding Path=(local:SoftClaySurface.Material),RelativeSource={RelativeSource TemplatedParent}}">
          <Grid>
            <!-- 悬停底色是随材质运动的独立叠加层，由 SoftClayLight 弹簧连续点亮；按下仍由 State 承接。 -->
            <Border CornerRadius="{DynamicResource ClayControlRadius}" Background="{DynamicResource ClayHover}" Opacity="0" local:SoftClayLight.When="IsMouseOver"/>
            <Border x:Name="State" CornerRadius="{DynamicResource ClayControlRadius}" Background="Transparent"/>
          </Grid>
        </local:SoftClaySurface>
        <ContentPresenter x:Name="Glyph" IsHitTestVisible="False" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
        <Border x:Name="Focus" Background="{DynamicResource ClayFocusFill}" BorderThickness="0"
                CornerRadius="{DynamicResource ClayControlRadius}" Opacity="0" IsHitTestVisible="False" local:SoftClayLight.When="IsKeyboardFocused"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="State" Property="Background" Value="{DynamicResource ClayPressed}"/><Setter TargetName="Face" Property="Material" Value="Pressed"/><Setter Property="Effect" Value="{x:Null}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource ClayDisabledOpacity}"/><Setter TargetName="State" Property="Background" Value="Transparent"/><Setter TargetName="Face" Property="Material" Value="Flat"/><Setter Property="Effect" Value="{x:Null}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource ClayButton}"/>
  <!-- 钉图使用轨道的常驻材质层；按压/选中由同一物理进度混合，不触发模板或皮肤替换。 -->
  <Style x:Key="ClayRailButton" TargetType="local:SoftClayRailButton" BasedOn="{StaticResource ClayControl}">
    <Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="4"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:SoftClayRailButton">
      <Grid Background="Transparent">
        <Grid x:Name="RailFace" IsHitTestVisible="False">
          <local:SoftClaySurface x:Name="RailBase" RailBend="0" CornerRadius="{DynamicResource ClayControlRadius}" Background="{DynamicResource ClayRaised}"/>
          <local:SoftClaySurface x:Name="RailRaised" RailBend="0" CornerRadius="{DynamicResource ClayControlRadius}" Background="{DynamicResource ClayRaised}" Material="Raised" Effect="{DynamicResource ClayButtonShadow}"/>
          <local:SoftClaySurface x:Name="RailColor" RailBend="0" CornerRadius="{DynamicResource ClayControlRadius}" Background="{DynamicResource ClayPrimary}" Opacity="0"/>
          <local:SoftClaySurface x:Name="RailPrimary" RailBend="0" CornerRadius="{DynamicResource ClayControlRadius}" Background="{DynamicResource ClayPrimary}" Material="Primary" Effect="{DynamicResource ClayPrimaryShadow}" Opacity="0"/>
          <local:SoftClaySurface x:Name="RailDepth" RailBend="0" CornerRadius="{DynamicResource ClayControlRadius}" Material="Pressed" Opacity="0"/>
          <local:SoftClaySurface x:Name="RailLight" RailBend="0" CornerRadius="{DynamicResource ClayControlRadius}" Opacity="0"/>
          <local:SoftClaySurface x:Name="RailFocus" RailBend="0" CornerRadius="{DynamicResource ClayControlRadius}" Background="{DynamicResource ClayFocusFill}" Opacity="0"/>
        </Grid>
        <ContentPresenter x:Name="RailGlyph" IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource ClayDisabledOpacity}"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ClayPrimaryButton" TargetType="Button" BasedOn="{StaticResource ClayButton}">
    <Setter Property="local:SoftClaySurface.Material" Value="Primary"/>
    <Setter Property="Background" Value="{DynamicResource ClayPrimary}"/><Setter Property="Foreground" Value="{DynamicResource ClayOnAccent}"/><Setter Property="Effect" Value="{DynamicResource ClayPrimaryShadow}"/>
  </Style>
  <Style x:Key="ClayDangerButton" TargetType="Button" BasedOn="{StaticResource ClayButton}">
    <Setter Property="Foreground" Value="{DynamicResource ClayError}"/>
  </Style>
  <Style x:Key="ClayTextButton" TargetType="Button" BasedOn="{StaticResource ClayButton}">
    <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="8,5"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="Effect" Value="{x:Null}"/>
    <Setter Property="local:SoftClaySurface.Material" Value="Flat"/>
  </Style>
  <Style x:Key="ClayCloseButton" TargetType="Button" BasedOn="{StaticResource ClayButton}">
    <Setter Property="MinHeight" Value="32"/><Setter Property="Width" Value="32"/><Setter Property="Padding" Value="8"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Effect" Value="{x:Null}"/>
    <Setter Property="local:SoftClaySurface.Material" Value="Flat"/>
    <Setter Property="AutomationProperties.Name" Value="关闭"/><Setter Property="ToolTip" Value="关闭"/>
    <Setter Property="Content" Value="关闭"/>
    <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
      <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Width="12" Height="12" Stroke="{DynamicResource ClayMuted}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
    </DataTemplate></Setter.Value></Setter>
  </Style>

  <!-- 独立材质承接体积变化，ContentPresenter 不在其缩放子树中。 -->
  <Style TargetType="local:SoftClayPopupSurface" BasedOn="{StaticResource ClayControl}">
    <Setter Property="Background" Value="{DynamicResource ClaySurface}"/><Setter Property="CornerRadius" Value="{DynamicResource ClayFloatingRadius}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:SoftClayPopupSurface">
      <Grid Background="Transparent">
        <local:SoftClaySurface x:Name="Face" IsHitTestVisible="False" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Material="Floating" Effect="{DynamicResource ClayShadow}"/>
        <ContentPresenter x:Name="Glyph" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsClosing" Value="True"><Setter Property="IsHitTestVisible" Value="False"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- 通知的关闭槽位使用独立 HWND，透明材质仍复用 Popup 的有界退出。 -->
  <Style x:Key="ClayNoticeClose" TargetType="local:SoftClayPopupSurface" BasedOn="{StaticResource {x:Type local:SoftClayPopupSurface}}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:SoftClayPopupSurface">
      <!-- 极低非零 alpha 保留分层窗口完整的 32px 命中槽位，避免只能点中叉号笔画。 -->
      <Grid Background="#01000000"><Border x:Name="Face" IsHitTestVisible="False"/><ContentPresenter x:Name="Glyph"/></Grid>
      <ControlTemplate.Triggers><Trigger Property="IsClosing" Value="True"><Setter Property="IsHitTestVisible" Value="False"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip" BasedOn="{StaticResource ClayControl}">
    <Setter Property="Background" Value="{DynamicResource ClayWell}"/><Setter Property="Padding" Value="10,7"/><Setter Property="MaxWidth" Value="280"/>
    <Setter Property="FontSize" Value="{DynamicResource ClayLabelSize}"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
      <local:SoftClayPopupSurface Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="8" Margin="8">
        <ContentPresenter><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources></ContentPresenter>
      </local:SoftClayPopupSurface>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ClayMenuItem" TargetType="MenuItem" BasedOn="{StaticResource ClayControl}">
    <Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="{DynamicResource ClayCompactHeight}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
      <!-- 高亮与键盘焦点是叠在底面上的两层，按各自弹簧交叉淡入淡出；焦点层在上，与原触发器优先级一致。 -->
      <Grid Margin="0,1">
        <Border x:Name="Face" CornerRadius="{DynamicResource ClayControlRadius}" Background="Transparent" BorderThickness="0"/>
        <Border CornerRadius="{DynamicResource ClayControlRadius}" Background="{DynamicResource ClayHover}" Opacity="0" local:SoftClayLight.When="IsHighlighted&amp;!IsKeyboardFocusWithin"/>
        <Border CornerRadius="{DynamicResource ClayControlRadius}" Background="{DynamicResource ClaySelected}" Opacity="0" local:SoftClayLight.When="IsKeyboardFocusWithin"/>
        <Grid Margin="{TemplateBinding Padding}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource ClayMuted}" FontSize="{DynamicResource ClayLabelSize}" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </Grid>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource ClayDisabledOpacity}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="MenuItem" BasedOn="{StaticResource ClayMenuItem}"/>
  <Style x:Key="ClayMenuSeparator" TargetType="Separator">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Grid Height="12" IsHitTestVisible="False"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Separator" BasedOn="{StaticResource ClayMenuSeparator}"/>
  <Style x:Key="ClayMenu" TargetType="ContextMenu" BasedOn="{StaticResource ClayControl}">
    <Setter Property="MinWidth" Value="180"/><Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource ClayMenuItem}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
      <local:SoftClayPopupSurface Margin="16" Padding="4">
        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
      </local:SoftClayPopupSurface>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ContextMenu" BasedOn="{StaticResource ClayMenu}"/>
  <!-- 文本编辑仍用 WPF 标准命令，但不再出现默认白色右键菜单。 -->
  <ContextMenu x:Key="ClayTextMenu" x:Shared="False" Style="{StaticResource ClayMenu}">
    <MenuItem Header="剪切" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X" CommandTarget="{Binding PlacementTarget,RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
    <MenuItem Header="复制" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" CommandTarget="{Binding PlacementTarget,RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
    <MenuItem Header="粘贴" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V" CommandTarget="{Binding PlacementTarget,RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
    <Separator/>
    <MenuItem Header="全选" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A" CommandTarget="{Binding PlacementTarget,RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
  </ContextMenu>
  <Style x:Key="ClayField" TargetType="Control" BasedOn="{StaticResource ClayControl}">
    <Setter Property="Background" Value="{DynamicResource ClayWell}"/><Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,9"/><Setter Property="MinHeight" Value="{DynamicResource ClayControlHeight}"/>
    <Setter Property="ContextMenu" Value="{StaticResource ClayTextMenu}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
      <Grid>
        <local:SoftClaySurface x:Name="Face" CornerRadius="{DynamicResource ClayControlRadius}" Background="{TemplateBinding Background}" BorderThickness="0" Material="Inset">
          <Grid>
            <!-- 悬停激活底色在文字下方连续点亮；校验错误时让出错误底色。 -->
            <Border CornerRadius="{DynamicResource ClayControlRadius}" Background="{DynamicResource ClayWellActive}" Opacity="0" IsHitTestVisible="False" local:SoftClayLight.When="IsMouseOver&amp;!HasError"/>
            <!-- 内容宿主只传一次内边距，避免单行输入比下拉框多出一层高度。 -->
            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Grid>
        </local:SoftClaySurface>
        <Border x:Name="Focus" CornerRadius="{DynamicResource ClayControlRadius}" Background="{DynamicResource ClayFocusFill}" BorderThickness="0" Opacity="0" IsHitTestVisible="False" local:SoftClayLight.When="IsKeyboardFocusWithin"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource ClayErrorSurface}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource ClayDisabledOpacity}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource ClayField}">
    <Setter Property="CaretBrush" Value="{DynamicResource ClayControlFocus}"/><Setter Property="SelectionBrush" Value="{DynamicResource ClaySelection}"/><Setter Property="SelectionOpacity" Value="1"/>
    <Style.Triggers><MultiTrigger><MultiTrigger.Conditions><Condition Property="TextWrapping" Value="NoWrap"/><Condition Property="AcceptsReturn" Value="False"/></MultiTrigger.Conditions><Setter Property="Height" Value="{DynamicResource ClayControlHeight}"/><Setter Property="VerticalContentAlignment" Value="Center"/></MultiTrigger></Style.Triggers>
  </Style>
  <Style TargetType="PasswordBox" BasedOn="{StaticResource ClayField}">
    <Setter Property="CaretBrush" Value="{DynamicResource ClayControlFocus}"/><Setter Property="SelectionBrush" Value="{DynamicResource ClaySelection}"/>
    <Setter Property="Height" Value="{DynamicResource ClayControlHeight}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="RichTextBox" BasedOn="{StaticResource ClayField}">
    <Setter Property="CaretBrush" Value="{DynamicResource ClayControlFocus}"/><Setter Property="SelectionBrush" Value="{DynamicResource ClaySelection}"/><Setter Property="SelectionOpacity" Value="1"/>
  </Style>
  <Style x:Key="ClayReadOnlyText" TargetType="TextBox" BasedOn="{StaticResource ClayControl}">
    <Setter Property="IsReadOnly" Value="True"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/><Setter Property="ContextMenu" Value="{StaticResource ClayTextMenu}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource ClaySelection}"/><Setter Property="SelectionOpacity" Value="1"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Label" BasedOn="{StaticResource ClayControl}">
    <Setter Property="FontSize" Value="{DynamicResource ClayLabelSize}"/><Setter Property="Foreground" Value="{DynamicResource ClayMuted}"/>
    <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Label"><ContentPresenter RecognizesAccessKey="True"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource ClayControl}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Grid Background="Transparent" MinHeight="28">
        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <local:SoftClaySurface x:Name="Face" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="5" Background="{DynamicResource ClayWell}" BorderThickness="0" Material="Inset">
          <!-- 未勾选时的悬停底色在材质内连续点亮，随材质一起迎向；勾选或不确定态使用强调底色，悬停层随之熄灭。 -->
          <Border CornerRadius="5" Background="{DynamicResource ClayWellActive}" Opacity="0" IsHitTestVisible="False" local:SoftClayLight.When="IsMouseOver&amp;!IsCheckedAny"/>
        </local:SoftClaySurface>
        <Grid x:Name="Glyph" Grid.ColumnSpan="2" IsHitTestVisible="False">
          <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Path x:Name="Mark" Data="M 4,9 L 8,12 L 14,5" Stroke="{DynamicResource ClayOnAccent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
            <Path x:Name="Mixed" Data="M 5,9 H 13" Stroke="{DynamicResource ClayOnAccent}" StrokeThickness="2" Visibility="Collapsed"/>
          </Grid>
          <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Grid>
        <Border x:Name="Focus" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="5" Background="{DynamicResource ClayFocusFill}" BorderThickness="0" Opacity="0" IsHitTestVisible="False" local:SoftClayLight.When="IsKeyboardFocused"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource ClayAccentBottom}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="Face" Property="Background" Value="{DynamicResource ClayAccentBottom}"/><Setter TargetName="Mixed" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.75"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource ClayDisabledOpacity}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="ClayItem" TargetType="ContentControl" BasedOn="{StaticResource ClayControl}">
    <Setter Property="MinHeight" Value="{DynamicResource ClayCompactHeight}"/><Setter Property="Padding" Value="12,8"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
      <!-- 悬停与选中/键盘焦点各为一层：选中层点亮时悬停层同步熄灭，两种底色交叉过渡而不叠加。 -->
      <Grid>
        <Border x:Name="Face" CornerRadius="{DynamicResource ClayControlRadius}" Background="{TemplateBinding Background}" BorderThickness="0"/>
        <Border CornerRadius="{DynamicResource ClayControlRadius}" Background="{DynamicResource ClayHover}" Opacity="0" IsHitTestVisible="False" local:SoftClayLight.When="IsMouseOver&amp;!IsSelected&amp;!IsKeyboardFocusWithin"/>
        <Border CornerRadius="{DynamicResource ClayControlRadius}" Background="{DynamicResource ClaySelected}" Opacity="0" IsHitTestVisible="False" local:SoftClayLight.When="IsSelected|IsKeyboardFocusWithin"/>
        <ContentPresenter x:Name="ItemContent" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource ClayDisabledOpacity}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ClayItem}"/>
  <Style TargetType="ListBoxItem" BasedOn="{StaticResource ClayItem}"><Setter Property="Margin" Value="0,0,0,4"/></Style>
  <Style x:Key="ClayComboBox" TargetType="ComboBox" BasedOn="{StaticResource ClayControl}">
    <Setter Property="MinHeight" Value="{DynamicResource ClayControlHeight}"/><Setter Property="Background" Value="{DynamicResource ClayWell}"/>
    <Setter Property="MaxDropDownHeight" Value="280"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <!-- 内部按钮显式沿用下拉框字体与前景色，避免系统 ToggleButton 样式将选中文字改回黑色。 -->
        <ToggleButton x:Name="Toggle" Focusable="False" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                      IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
            <!-- 固定输入槽位；底板承接形变，文字与箭头共享不缩放的图文层。 -->
            <Grid Background="Transparent">
              <local:SoftClaySurface x:Name="Face" IsHitTestVisible="False" CornerRadius="{DynamicResource ClayControlRadius}" Background="{DynamicResource ClayWell}" BorderThickness="0" Material="Inset">
                <!-- 悬停与展开共用激活底色层，焦点层读取下拉框的键盘焦点；两层都随材质运动并由弹簧连续点亮。 -->
                <Grid>
                  <Border CornerRadius="{DynamicResource ClayControlRadius}" Background="{DynamicResource ClayWellActive}" Opacity="0" local:SoftClayLight.When="IsMouseOver|IsChecked"/>
                  <Border x:Name="Focus" CornerRadius="{DynamicResource ClayControlRadius}" Background="{DynamicResource ClayFocusFill}" Opacity="0" local:SoftClayLight.When="IsKeyboardFocusWithin" local:SoftClayLight.OwnerType="{x:Type ComboBox}"/>
                </Grid>
              </local:SoftClaySurface>
              <Grid x:Name="Glyph" IsHitTestVisible="False">
                <ContentPresenter Margin="12,9,36,9" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"
                                  Content="{Binding SelectionBoxItem,RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                  ContentTemplate="{Binding SelectionBoxItemTemplate,RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                  ContentTemplateSelector="{Binding ItemTemplateSelector,RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat,RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"/>
                <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource ClayMuted}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
              </Grid>
            </Grid>
          </ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
          <local:SoftClayPopupSurface Margin="12" Padding="4" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}">
            <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
          </local:SoftClayPopupSurface>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource ClayDisabledOpacity}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource ClayComboBox}"/>
  <Style TargetType="ListBox" BasedOn="{StaticResource ClayControl}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
      <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
        <ScrollViewer Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"><ItemsPresenter/></ScrollViewer>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ClayTab" TargetType="TabItem" BasedOn="{StaticResource ClayControl}">
    <Setter Property="Foreground" Value="{DynamicResource ClayMuted}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
      <local:SoftClaySurface x:Name="Face" CornerRadius="{DynamicResource ClayControlRadius}" Background="Transparent" BorderThickness="0" Padding="16,9" Margin="0,0,8,0" MinHeight="{DynamicResource ClayControlHeight}">
        <Grid>
          <!-- 叠加层用负外距抵消材质内边距铺满整张标签；未选中时悬停点亮，键盘焦点层在最上方。 -->
          <Border Margin="-16,-9" CornerRadius="{DynamicResource ClayControlRadius}" Background="{DynamicResource ClayHover}" Opacity="0" IsHitTestVisible="False" local:SoftClayLight.When="IsMouseOver&amp;!IsSelected"/>
          <Border Margin="-16,-9" CornerRadius="{DynamicResource ClayControlRadius}" Background="{DynamicResource ClaySelected}" Opacity="0" IsHitTestVisible="False" local:SoftClayLight.When="IsKeyboardFocused"/>
          <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True"/>
        </Grid>
      </local:SoftClaySurface>
      <ControlTemplate.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource ClayInk}"/><Setter TargetName="Face" Property="Background" Value="{DynamicResource ClayRaised}"/><Setter TargetName="Face" Property="Material" Value="Raised"/><Setter TargetName="Face" Property="Effect" Value="{DynamicResource ClayButtonShadow}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource ClayDisabledOpacity}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem" BasedOn="{StaticResource ClayTab}"/>
  <Style TargetType="TabControl" BasedOn="{StaticResource ClayControl}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
        <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Expander" BasedOn="{StaticResource ClayControl}">
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
      <StackPanel>
        <ToggleButton x:Name="HeaderToggle" IsChecked="{Binding IsExpanded,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" FocusVisualStyle="{x:Null}"
                      Padding="{TemplateBinding Padding}" MinHeight="{DynamicResource ClayControlHeight}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
            <Grid Background="Transparent">
              <!-- 悬停/展开底色与键盘焦点底色放在材质内，随迎向一起移动并由弹簧连续点亮。 -->
              <Border x:Name="Face" Background="Transparent" BorderThickness="0" CornerRadius="{DynamicResource ClayControlRadius}">
                <Grid>
                  <Border CornerRadius="{DynamicResource ClayControlRadius}" Background="{DynamicResource ClayHover}" Opacity="0" local:SoftClayLight.When="IsMouseOver|IsChecked"/>
                  <Border CornerRadius="{DynamicResource ClayControlRadius}" Background="{DynamicResource ClayFocusFill}" Opacity="0" local:SoftClayLight.When="IsKeyboardFocused"/>
                </Grid>
              </Border>
              <Grid x:Name="Glyph" Margin="{TemplateBinding Padding}" IsHitTestVisible="False"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ContentPresenter Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource ClayMuted}" StrokeThickness="1.8" RenderTransformOrigin="0.5,0.5"/>
              </Grid>
            </Grid>
          </ControlTemplate></ToggleButton.Template>
          <ContentPresenter Content="{TemplateBinding Header}" TextElement.Foreground="{DynamicResource ClayInk}"/>
        </ToggleButton>
        <local:SoftClayDisclosure x:Name="Expansion" IsExpanded="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent}}">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" Margin="12,12,12,0"/>
        </local:SoftClayDisclosure>
      </StackPanel>
      <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource ClayDisabledOpacity}"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- PART 名称和标准滚动命令保留；纵横滚动条及角落均不借用系统模板。 -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="{DynamicResource ClayScrollThickness}"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb x:Name="GripControl" MinHeight="{DynamicResource ClayScrollMinThumb}" Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><!-- 悬停与拖动颜色各为一层，由弹簧交叉点亮。 --><Grid Margin="{DynamicResource ClayScrollThumbMargin}"><Border x:Name="Grip" Background="{DynamicResource ClayScrollbar}" CornerRadius="4"/><Border Background="{DynamicResource ClayMuted}" CornerRadius="4" Opacity="0" local:SoftClayLight.When="IsMouseOver&amp;!IsDragging"/><Border Background="{DynamicResource ClayFocus}" CornerRadius="4" Opacity="0" local:SoftClayLight.When="IsDragging"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
      </Track>
      <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="{DynamicResource ClayScrollThickness}"/><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="GripControl" Property="MinHeight" Value="0"/><Setter TargetName="GripControl" Property="MinWidth" Value="{DynamicResource ClayScrollMinThumb}"/><Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollViewer">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="local:OverlayScrollbars.Enabled" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
      <Grid Background="{TemplateBinding Background}">
        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
        <ScrollBar x:Name="PART_VerticalScrollBar" Panel.ZIndex="1" HorizontalAlignment="Right" Margin="0,8,1,8" Opacity="0" IsHitTestVisible="False" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
        <ScrollBar x:Name="PART_HorizontalScrollBar" Panel.ZIndex="1" VerticalAlignment="Bottom" Margin="8,0,8,1" Opacity="0" IsHitTestVisible="False" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{TemplateBinding HorizontalOffset}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="ComputedHorizontalScrollBarVisibility" Value="Visible"><Setter TargetName="PART_VerticalScrollBar" Property="Margin" Value="0,8,1,12"/></Trigger>
        <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Visible"><Setter TargetName="PART_HorizontalScrollBar" Property="Margin" Value="8,0,12,1"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- 页面滑块延伸到浮卡侧边，等量内容内距保留表单原宽度；文本井和菜单不使用此布局。 -->
  <Style x:Key="ClayPageScrollViewer" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
    <Setter Property="Margin" Value="0,20,-16,0"/>
    <Setter Property="Padding" Value="0,0,16,0"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>
  <Style TargetType="ProgressBar" BasedOn="{StaticResource ClayControl}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
      <Border CornerRadius="3" Background="{DynamicResource ClayWell}"><Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource ClayAccent}"/></Grid></Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ResizeGrip"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ResizeGrip"><Path Data="M 3,12 L 12,3 M 7,12 L 12,7 M 11,12 L 12,11" Stroke="{DynamicResource ClayMuted}" StrokeThickness="1.5" Width="14" Height="14"/></ControlTemplate></Setter.Value></Setter></Style>
  <!-- 兼容现有命名引用，但不再维护设置页专用的第二套控件模板。 -->
  <Style x:Key="ClayPanelButton" TargetType="Button" BasedOn="{StaticResource ClayButton}"/>
  <Style x:Key="ClayPanelField" TargetType="Control" BasedOn="{StaticResource ClayField}"/>
  <Style x:Key="ClayPanelComboBox" TargetType="ComboBox" BasedOn="{StaticResource ClayComboBox}"/>
  <Style x:Key="ClayPanelTab" TargetType="TabItem" BasedOn="{StaticResource ClayTab}"/>
  <Style x:Key="ClayPanelScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}"/>
  <Style x:Key="ClayTrayItem" TargetType="MenuItem" BasedOn="{StaticResource ClayMenuItem}"/>
  <Style x:Key="ClayTraySeparator" TargetType="Separator" BasedOn="{StaticResource ClayMenuSeparator}"/>
  <Style x:Key="ClayTrayMenu" TargetType="ContextMenu" BasedOn="{StaticResource ClayMenu}"><Setter Property="MinWidth" Value="286"/></Style>
</ResourceDictionary>
