<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 原生设置及条款沿用 WPF 行为，表面、焦点与选择态均引用宿主装载的共享 token。 -->
  <Style x:Key="ClayField" TargetType="Control">
    <Setter Property="Foreground" Value="{DynamicResource ClayInk}"/><Setter Property="Background" Value="{DynamicResource ClayWell}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ClaySurfaceBottom}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
      <Border x:Name="Face" CornerRadius="{DynamicResource ClayControlRadius}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
      </Border>
      <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource ClayFocus}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource ClayField}"/>
  <Style TargetType="PasswordBox" BasedOn="{StaticResource ClayField}"/>
  <Style TargetType="RichTextBox" BasedOn="{StaticResource ClayField}"/>
  <Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource ClayInk}"/></Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource ClayInk}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="Face" Width="18" Height="18" VerticalAlignment="Center" CornerRadius="5" Background="{DynamicResource ClayWell}" BorderThickness="1" BorderBrush="{DynamicResource ClayMuted}">
          <Path x:Name="Mark" Data="M 3,8 L 7,12 L 14,4" Stroke="{DynamicResource ClayInk}" StrokeThickness="2" Visibility="Collapsed"/>
        </Border><ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource ClayAccent}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource ClayFocus}"/><Setter TargetName="Face" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource ClayInk}"/><Setter Property="Background" Value="{DynamicResource ClaySurface}"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border CornerRadius="{DynamicResource ClayControlRadius}" Background="{DynamicResource ClaySurface}" BorderThickness="1" BorderBrush="{DynamicResource ClayMuted}"><Path HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource ClayInk}" StrokeThickness="1.5"/></Border></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter Margin="12,8,32,8" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False" VerticalAlignment="Center"/>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
          <Border Background="{DynamicResource ClaySurface}" CornerRadius="{DynamicResource ClayControlRadius}" Padding="6" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="300" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Toggle" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ClayItem" TargetType="ContentControl">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource ClayInk}"/><Setter Property="Padding" Value="12,8"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ClayControlRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="ItemContent"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource ClaySurface}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource ClayAccent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ClayItem}"/>
  <Style TargetType="ListBoxItem" BasedOn="{StaticResource ClayItem}"><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ClayAccent}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource ClayWell}"/><Setter Property="Foreground" Value="{DynamicResource ClayInk}"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource ClayInk}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Face" Background="{DynamicResource ClaySurface}" CornerRadius="{DynamicResource ClayControlRadius}" Padding="14,10" Margin="0,0,8,8"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource ClayAccent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource ClayFocus}"/><Setter TargetName="Face" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><DockPanel><TabPanel DockPanel.Dock="Top" IsItemsHost="True"/><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></DockPanel></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ProgressBar"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Border CornerRadius="7" Background="{DynamicResource ClayWell}"><Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="7" Background="{DynamicResource ClayAccent}"/></Grid></Border></ControlTemplate></Setter.Value></Setter></Style>
  <!-- 滚动条保留 Track/Thumb 与标准滚动命令，仅替换默认箭头及灰色表面。 -->
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True">
      <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb><Thumb.Template><ControlTemplate><Border Background="{DynamicResource ClaySurface}" CornerRadius="5" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track>
    <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>

  <!-- 托盘入口采用同一软泥浮卡，菜单项保留 WPF 原生方向键、Enter、Esc 和屏幕阅读器行为。 -->
  <Style x:Key="ClayTrayItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource ClayInk}"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="36"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
      <Border x:Name="Face" CornerRadius="8" Padding="10,7" Margin="0,1" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ContentPresenter ContentSource="Icon" VerticalAlignment="Center"/>
          <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource ClayMuted}" FontSize="11" Margin="18,0,0,0" VerticalAlignment="Center"/>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource ClaySurface}"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource ClayFocus}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ClayTraySeparator" TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="10,6" Background="{DynamicResource ClayMuted}" Opacity="0.22"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ClayTrayMenu" TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{DynamicResource ClayInk}"/><Setter Property="MinWidth" Value="286"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource ClayTrayItem}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
      <Border Margin="16" Padding="8" CornerRadius="12" Background="{DynamicResource ClaySurface}">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35"/></Border.Effect>
        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
