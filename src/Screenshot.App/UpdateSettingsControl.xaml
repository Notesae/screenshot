<UserControl x:Class="Screenshot.App.UpdateSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 更新页沿用所属设置浮卡的字号与按钮，不另起一套页面外观。 -->
    <UserControl.Resources><Style TargetType="Button" BasedOn="{StaticResource ClayPanelButton}"><Setter Property="Margin" Value="0,0,8,8"/></Style></UserControl.Resources>
    <ScrollViewer Style="{StaticResource ClayPageScrollViewer}">
        <StackPanel>
            <TextBlock Text="应用更新" FontSize="{DynamicResource ClayBodySize}" FontWeight="SemiBold"/>
            <TextBlock x:Name="CurrentVersion" Margin="0,12,0,12"/>
            <TextBlock Text="官方公开发布源 · 无需登录" FontSize="{DynamicResource ClayBodySize}" FontWeight="SemiBold"/>
            <TextBlock Margin="0,8,0,16" TextWrapping="Wrap" Foreground="{DynamicResource ClayMuted}" Text="仅匿名访问 Notesae/screenshot 官方公开 Release，不请求 GitHub 授权，不读取浏览器、Git 或开发机凭据。"/>
            <Label Content="更新通道" Target="{Binding ElementName=Channel}"/>
            <ComboBox x:Name="Channel" SelectedIndex="0" Margin="0,0,0,8" SelectionChanged="Channel_Changed">
                <ComboBoxItem Content="仅稳定版（默认）"/>
                <ComboBoxItem Content="稳定版及预发布（主动选择，可能不稳定）"/>
            </ComboBox>
            <TextBlock Text="只在手动检查时访问 Notesae/screenshot 官方发布。默认仅稳定版；当前只有预发布时会明确提示。预发布需主动选择，不会自动降级或安装相同版本。" TextWrapping="Wrap" Foreground="{DynamicResource ClayMuted}"/>
            <WrapPanel Margin="0,16,0,16">
                <Button x:Name="CheckButton" Content="检查更新" Click="Check_Click"/>
                <Button x:Name="DownloadButton" Content="下载更新" IsEnabled="False" Click="Download_Click"/>
                <Button x:Name="CancelButton" Content="取消" IsEnabled="False" Click="Cancel_Click"/>
            </WrapPanel>
            <TextBlock x:Name="LatestVersion" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <!-- 说明随新版本出现，普通只读文字不套用表单的黑色输入框。 -->
            <Border x:Name="ReleaseDetails" Visibility="Collapsed" Background="{DynamicResource ClayHover}" BorderThickness="0" CornerRadius="{DynamicResource ClayControlRadius}" Padding="12" Margin="0,12,0,16">
                <StackPanel>
                    <TextBlock Text="更新内容" Foreground="{DynamicResource ClayMuted}" FontSize="{DynamicResource ClayLabelSize}" Margin="0,0,0,8"/>
                    <TextBox x:Name="ReleaseNotes" Style="{StaticResource ClayReadOnlyText}" TextWrapping="Wrap" MaxHeight="170" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="新版本说明">
                    </TextBox>
                </StackPanel>
            </Border>
            <!-- 进度仅属于正在进行的下载；空闲、检查结束和取消后均不占空间。 -->
            <StackPanel x:Name="DownloadProgress" Visibility="Collapsed" Margin="0,12,0,12">
                <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" AutomationProperties.Name="更新下载进度"/>
                <TextBlock x:Name="ProgressText" Margin="0,8,0,0" Foreground="{DynamicResource ClayMuted}" FontSize="{DynamicResource ClayLabelSize}"/>
            </StackPanel>
            <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Foreground="{DynamicResource ClayMuted}" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Margin="0,14,0,14" TextWrapping="Wrap" Foreground="{DynamicResource ClayMuted}"
                       Text="下载将校验官方 API 的 SHA-256 和包内清单。这是完整性检查，当前便携 ZIP 没有发布者数字签名；仍信任 GitHub 官方仓库账号及 HTTPS，无法抵御发布账号失陷。"/>
            <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" Text="安装会关闭并重启应用，不会自动保存当前编辑；需要保留时请先手动保存项目。原安装目录会保留为回滚备份，用户设置、密钥及恢复库留在原数据目录。含额外文件、只读目录或被其他实例占用时，不覆盖安装。"/>
            <WrapPanel>
                <Button Style="{StaticResource ClayPrimaryButton}" Margin="0,0,8,8" x:Name="InstallButton" Content="安装并重启…" IsEnabled="False" Click="Install_Click"/>
                <Button x:Name="ExportButton" Content="解压到新目录…" IsEnabled="False" Click="Export_Click"/>
                <Button x:Name="RollbackButton" Content="回滚并重启…" IsEnabled="False" Click="Rollback_Click"/>
            </WrapPanel>
            <TextBlock x:Name="RecoveryInfo" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ClayMuted}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
