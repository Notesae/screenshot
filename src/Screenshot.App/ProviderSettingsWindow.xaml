<Window x:Class="Screenshot.App.ProviderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Screenshot.App"
        Title="设置" Width="680" Height="780" MinWidth="600" MinHeight="560"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="Transparent" Foreground="{DynamicResource ClayInk}" FontFamily="{DynamicResource ClayFont}" FontSize="{DynamicResource ClayBodySize}">
    <Window.Resources>
        <!-- 仅保留此表单的布局角色，控件模板统一从全局共享资源取得。 -->
        <Style x:Key="FieldGroup" TargetType="StackPanel"><Setter Property="Margin" Value="0,0,0,16"/></Style>
        <Style x:Key="FieldHint" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ClayMuted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/><Setter Property="FontSize" Value="{DynamicResource ClayLabelSize}"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
        <Style x:Key="FeedbackText" TargetType="TextBlock" BasedOn="{StaticResource FieldHint}"><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="AutomationProperties.LiveSetting" Value="Polite"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
    </Window.Resources>
    <!-- 与编辑器属性卡相同的暖灰渐变、圆角、高光和外投影；窗口只承担原生安全边界。 -->
    <local:SoftClayPopupSurface Margin="16">

    <Grid Margin="20,12,20,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="-4,0,-4,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll" MinHeight="32">
                <TextBlock Text="设置" FontSize="{DynamicResource ClayTitleSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
            <Button x:Name="TermsButton" Grid.Column="1" Content="使用条款" Click="Terms_Click" Style="{StaticResource ClayTextButton}" Margin="0,0,12,0"/>
            <Button Grid.Column="2" IsCancel="True" Style="{StaticResource ClayCloseButton}" AutomationProperties.Name="关闭设置"/>
        </Grid>
        <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="Transparent">
            <TabItem x:Name="CaptureTab" Header="截图与快捷键">
                <ScrollViewer Style="{StaticResource ClayPageScrollViewer}"><StackPanel x:Name="CapturePreferences">
                    <StackPanel Style="{StaticResource FieldGroup}">
                        <Label Content="截图方式" Target="{Binding ElementName=CaptureBackend}"/>
                        <ComboBox x:Name="CaptureBackend" AutomationProperties.Name="截图方式"><ComboBoxItem Content="推荐 · WGC" Tag="wgc"/><ComboBoxItem Content="兼容 · GDI" Tag="gdi"/></ComboBox>
                        <TextBlock Text="适用于截图按钮和快捷键。失败时不会自动切换。" Style="{StaticResource FieldHint}"/>
                    </StackPanel>
                    <CheckBox x:Name="SnapWindows" Content="框选时吸附窗口" Margin="0,0,0,16"/>
                    <StackPanel Style="{StaticResource FieldGroup}">
                        <Label Content="吸附范围" Target="{Binding ElementName=SnapArea}"/>
                        <ComboBox x:Name="SnapArea"><ComboBoxItem Content="包含标题栏"/><ComboBoxItem Content="仅窗口内容"/></ComboBox>
                    </StackPanel>
                    <Button Content="应用截图设置" Click="ApplyCapture_Click" HorizontalAlignment="Left" Margin="0,0,0,24"/>
                    <Border BorderThickness="0" Padding="0,20,0,0"><StackPanel>
                        <TextBlock Text="区域截图快捷键" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <CheckBox x:Name="HotkeyEnabled" Content="启用全局快捷键" Margin="0,0,0,20"/>
                        <Label Content="组合键"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><CheckBox x:Name="HotkeyCtrl" Content="Ctrl" Margin="0,0,24,0"/><CheckBox x:Name="HotkeyAlt" Content="Alt" Margin="0,0,24,0"/><CheckBox x:Name="HotkeyShift" Content="Shift"/></StackPanel>
                        <Label Content="按键" Target="{Binding ElementName=HotkeyKey}"/>
                        <ComboBox x:Name="HotkeyKey" AutomationProperties.Name="区域截图快捷键按键"/>
                        <TextBlock Text="需包含 Ctrl 或 Alt，支持字母、数字和 F1–F11。" Style="{StaticResource FieldHint}"/>
                        <Button Content="应用快捷键" Click="ApplyHotkey_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                        <TextBlock x:Name="HotkeyMessage" Style="{StaticResource FieldHint}" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel></Border>
                    <TextBlock x:Name="CaptureStatus" Style="{StaticResource FeedbackText}" Margin="0,16,0,0"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem x:Name="ServicesTab" Header="识别与翻译">
                <Grid x:Name="SettingsForm" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="ProviderSidebarColumn" Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <!-- 有已保存连接才展示侧栏，首次打开不保留空列表占位。 -->
                    <Grid x:Name="ProviderSidebar" Visibility="Collapsed" Margin="0,0,16,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="我的服务" Foreground="{DynamicResource ClayMuted}" FontSize="{DynamicResource ClayLabelSize}" Margin="4,0,8,0" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="添加" Click="AddOpenAi_Click" Style="{StaticResource ClayTextButton}" ToolTip="添加服务" AutomationProperties.Name="添加服务"/>
                        </Grid>
                        <ListBox x:Name="ProviderList" Grid.Row="1" SelectionChanged="ProviderList_SelectionChanged" Background="Transparent" Padding="0" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="已保存的服务">
                            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Model}" Foreground="{DynamicResource ClayMuted}" FontSize="{DynamicResource ClayLabelSize}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <Grid Grid.Column="1" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock x:Name="FormTitle" Text="连接 AI 服务" FontSize="{DynamicResource ClayBodySize}" FontWeight="SemiBold"/>
                            <TextBlock Text="用于云端识别和翻译" Style="{StaticResource FieldHint}"/>
                        </StackPanel>
                        <ScrollViewer x:Name="ProviderScroll" Grid.Row="1" Style="{StaticResource ClayPageScrollViewer}" Margin="0,0,-16,0">
                            <StackPanel>
                                <StackPanel Style="{StaticResource FieldGroup}">
                                    <Label Content="服务类型" Target="{Binding ElementName=ProviderKind}"/>
                                    <ComboBox x:Name="ProviderKind" SelectedIndex="0" AutomationProperties.Name="服务类型">
                                        <ComboBoxItem Content="OpenAI 兼容服务" Tag="openai-compatible"/>
                                        <ComboBoxItem Content="Ollama 本地服务" Tag="ollama"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldGroup}">
                                    <Label Content="服务地址" Target="{Binding ElementName=ProviderBaseUrl}"/>
                                    <TextBox x:Name="ProviderBaseUrl" MaxLength="2048" AutomationProperties.Name="服务地址"/>
                                    <TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource FieldHint}">
                                        <Setter Property="Text" Value="填写服务商提供的地址，一般以 /v1 结尾。"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex,ElementName=ProviderKind}" Value="1"><Setter Property="Text" Value="本机通常填写 http://localhost:11434。"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style></TextBlock>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldGroup}">
                                    <Label Content="模型名称" Target="{Binding ElementName=ProviderModel}"/>
                                    <TextBox x:Name="ProviderModel" MaxLength="200" AutomationProperties.Name="模型名称"/>
                                    <TextBlock Text="截图翻译优先本地识别，再交给此模型翻译文字。" Style="{StaticResource FieldHint}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldGroup}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Label Content="API 密钥" Target="{Binding ElementName=ApiKey}"/><TextBlock x:Name="KeyBadge" Grid.Column="1" FontSize="{DynamicResource ClayLabelSize}" Foreground="{DynamicResource ClayMuted}"/></Grid>
                                    <!-- 占位只表示保存状态，不读回密钥或把示意圆点当作新密码保存。 -->
                                    <Grid><PasswordBox x:Name="ApiKey" MaxLength="8192" AutomationProperties.Name="API 密钥"/><TextBlock x:Name="KeyPlaceholder" Text="填写 API 密钥" Foreground="{DynamicResource ClayMuted}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="{DynamicResource ClayLabelSize}"/></Grid>
                                    <TextBlock x:Name="KeyState" Style="{StaticResource FieldHint}"/>
                                </StackPanel>
                                <Expander x:Name="MoreSettings" Header="更多设置" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Label Content="显示名称" Target="{Binding ElementName=ProviderName}"/>
                                        <TextBox x:Name="ProviderName" MaxLength="100" Margin="0,0,0,16" AutomationProperties.Name="服务显示名称"/>
                                        <CheckBox x:Name="MakeDefault" Content="设为默认服务" Margin="0,0,0,16"/>
                                        <CheckBox x:Name="ClearKey" Content="删除已保存的密钥" Visibility="Collapsed" Margin="0,0,0,12"/>
                                        <TextBlock Text="密钥加密保存在当前 Windows 账户下。" Style="{StaticResource FieldHint}"/>
                                        <Button x:Name="DeleteButton" Content="删除服务" Click="Delete_Click" Style="{StaticResource ClayDangerButton}" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                        <!-- 固定区只保留当前连接的反馈、测试和保存，服务管理放回列表与更多设置。 -->
                        <Border Grid.Row="2" BorderThickness="0" Margin="0,20,0,0">
                            <StackPanel>
                            <TextBlock x:Name="ConnectionTestResult" Style="{StaticResource FeedbackText}"/>
                            <TextBlock Text="测试仅发送示例文字，服务商可能计费。" Style="{StaticResource FieldHint}" Margin="0,0,0,12"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"><Button x:Name="TestConnectionButton" Content="测试连接" Click="TestConnection_Click"/><Button x:Name="CancelConnectionTestButton" Content="取消" Click="CancelConnectionTest_Click" Visibility="Collapsed" Margin="8,0,0,0"/></StackPanel>
                                <Button x:Name="SaveButton" Grid.Column="1" Content="保存连接" Click="Save_Click" Style="{StaticResource ClayPrimaryButton}" MinWidth="104" Margin="16,0,0,0"/>
                            </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="应用更新" x:Name="UpdateTab"/>
        </TabControl>
    </Grid>
    </local:SoftClayPopupSurface>
</Window>
