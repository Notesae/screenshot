<Window x:Class="Screenshot.App.ProviderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="680" Height="780" MinWidth="600" MinHeight="560"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="Transparent" Foreground="{DynamicResource ClayInk}" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <!-- 本地样式显式保留文字颜色，避免覆盖全局 Label 样式后回落到系统黑色。 -->
        <Style TargetType="Label"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource ClayMuted}"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ClayPanelField}"/>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource ClayPanelField}"/>
        <Style TargetType="Button" BasedOn="{StaticResource ClayPanelButton}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ClayPanelComboBox}"/>
        <Style TargetType="TabItem" BasedOn="{StaticResource ClayPanelTab}"/>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ClayPanelScrollBar}"/>
        <Style TargetType="ScrollViewer"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Padding" Value="0"/></Style>
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ClayItem}"><Setter Property="FontSize" Value="13"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1AFFFFFF"/></Trigger></Style.Triggers></Style>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ClayItem}"><Setter Property="Margin" Value="0,0,0,6"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1AFFFFFF"/></Trigger></Style.Triggers></Style>
        <Style x:Key="FieldGroup" TargetType="StackPanel"><Setter Property="Margin" Value="0,0,0,16"/></Style>
        <Style x:Key="FieldHint" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ClayMuted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource ClayInk}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
                <ToggleButton x:Name="Disclosure" IsChecked="{Binding IsExpanded,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" HorizontalContentAlignment="Stretch" Foreground="{DynamicResource ClayInk}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Face" Background="Transparent" Padding="0,12" BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0"><Grid><ContentPresenter/><Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource ClayMuted}" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource ClayFocus}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                    <ContentPresenter Content="{TemplateBinding Header}"/>
                </ToggleButton>
                <ContentPresenter x:Name="Expansion" Visibility="Collapsed" Margin="0,8,0,0"/>
            </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Expansion" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <!-- 与编辑器属性卡相同的暖灰渐变、圆角、高光和外投影；窗口只承担原生安全边界。 -->
    <Border Margin="16" CornerRadius="{DynamicResource ClayControlRadius}" Background="{DynamicResource ClaySurface}" BorderBrush="#29FFFFFF" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/></Border.Effect>
    <Grid Margin="20,12,20,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="-4,0,-4,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll" MinHeight="32">
                <TextBlock Text="设置" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
            <Button Grid.Column="1" IsCancel="True" Width="32" MinHeight="32" Padding="8" Background="Transparent" BorderThickness="0" AutomationProperties.Name="关闭设置" ToolTip="关闭">
                <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{DynamicResource ClayMuted}" StrokeThickness="1.5" Width="10" Height="10"/>
            </Button>
        </Grid>
        <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="Transparent">
            <TabItem x:Name="CaptureTab" Header="截图与快捷键">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,20,0,0"><StackPanel x:Name="CapturePreferences" Margin="0,0,8,0">
                    <StackPanel Style="{StaticResource FieldGroup}">
                        <Label Content="截图方式" Target="{Binding ElementName=CaptureBackend}"/>
                        <ComboBox x:Name="CaptureBackend" AutomationProperties.Name="截图方式"><ComboBoxItem Content="推荐 · WGC" Tag="wgc"/><ComboBoxItem Content="兼容 · GDI" Tag="gdi"/></ComboBox>
                        <TextBlock Text="适用于截图按钮和快捷键。失败时不会自动切换。" Style="{StaticResource FieldHint}"/>
                    </StackPanel>
                    <CheckBox x:Name="SnapWindows" Content="框选时吸附窗口" Margin="0,0,0,16"/>
                    <StackPanel Style="{StaticResource FieldGroup}">
                        <Label Content="吸附范围" Target="{Binding ElementName=SnapArea}"/>
                        <ComboBox x:Name="SnapArea"><ComboBoxItem Content="包含标题栏"/><ComboBoxItem Content="仅窗口内容"/></ComboBox>
                    </StackPanel>
                    <Button Content="应用截图设置" Click="ApplyCapture_Click" HorizontalAlignment="Left" Margin="0,0,0,24"/>
                    <Border BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0" Padding="0,20,0,0"><StackPanel>
                        <TextBlock Text="区域截图快捷键" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <CheckBox x:Name="HotkeyEnabled" Content="启用全局快捷键" Margin="0,0,0,20"/>
                        <Label Content="组合键"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><CheckBox x:Name="HotkeyCtrl" Content="Ctrl" Margin="0,0,24,0"/><CheckBox x:Name="HotkeyAlt" Content="Alt" Margin="0,0,24,0"/><CheckBox x:Name="HotkeyShift" Content="Shift"/></StackPanel>
                        <Label Content="按键" Target="{Binding ElementName=HotkeyKey}"/>
                        <ComboBox x:Name="HotkeyKey" AutomationProperties.Name="区域截图快捷键按键"/>
                        <TextBlock Text="需包含 Ctrl 或 Alt，支持字母、数字和 F1–F11。" Style="{StaticResource FieldHint}"/>
                        <Button Content="应用快捷键" Click="ApplyHotkey_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                        <TextBlock x:Name="HotkeyMessage" Style="{StaticResource FieldHint}" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem x:Name="ServicesTab" Header="识别与翻译">
                <Grid x:Name="SettingsForm" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="ProviderSidebarColumn" Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <!-- 有已保存连接才展示侧栏，首次打开不保留空列表占位。 -->
                    <Grid x:Name="ProviderSidebar" Visibility="Collapsed" Margin="0,0,16,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="我的服务" Foreground="{DynamicResource ClayMuted}" FontSize="12" Margin="4,0,0,12"/>
                        <ListBox x:Name="ProviderList" Grid.Row="1" SelectionChanged="ProviderList_SelectionChanged" Background="Transparent" Padding="0" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="已保存的服务">
                            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Model}" Foreground="{DynamicResource ClayMuted}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Row="2" Content="＋ 添加服务" Click="AddOpenAi_Click" Margin="0,16,0,0"/>
                    </Grid>
                    <Grid Grid.Column="1" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock x:Name="FormTitle" Text="连接 AI 服务" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="用于云端识别和翻译" Style="{StaticResource FieldHint}"/>
                        </StackPanel>
                        <ScrollViewer x:Name="ProviderScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,8,0">
                                <StackPanel Style="{StaticResource FieldGroup}">
                                    <Label Content="服务类型" Target="{Binding ElementName=ProviderKind}"/>
                                    <ComboBox x:Name="ProviderKind" SelectedIndex="0" AutomationProperties.Name="服务类型">
                                        <ComboBoxItem Content="OpenAI 兼容服务" Tag="openai-compatible"/>
                                        <ComboBoxItem Content="Ollama 本地服务" Tag="ollama"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldGroup}">
                                    <Label Content="服务地址" Target="{Binding ElementName=ProviderBaseUrl}"/>
                                    <TextBox x:Name="ProviderBaseUrl" MaxLength="2048" AutomationProperties.Name="服务地址"/>
                                    <TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource FieldHint}">
                                        <Setter Property="Text" Value="填写服务商提供的地址，一般以 /v1 结尾。"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex,ElementName=ProviderKind}" Value="1"><Setter Property="Text" Value="本机通常填写 http://localhost:11434。"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style></TextBlock>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldGroup}">
                                    <Label Content="模型名称" Target="{Binding ElementName=ProviderModel}"/>
                                    <TextBox x:Name="ProviderModel" MaxLength="200" AutomationProperties.Name="模型名称"/>
                                    <TextBlock Text="截图翻译优先本地识别，再交给此模型翻译文字。" Style="{StaticResource FieldHint}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldGroup}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Label Content="API 密钥" Target="{Binding ElementName=ApiKey}"/><TextBlock x:Name="KeyBadge" Grid.Column="1" FontSize="12" Foreground="{DynamicResource ClayFocus}"/></Grid>
                                    <!-- 占位只表示保存状态，不读回密钥或把示意圆点当作新密码保存。 -->
                                    <Grid><PasswordBox x:Name="ApiKey" MaxLength="8192" AutomationProperties.Name="API 密钥"/><TextBlock x:Name="KeyPlaceholder" Text="填写 API 密钥" Foreground="{DynamicResource ClayMuted}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12"/></Grid>
                                    <TextBlock x:Name="KeyState" Style="{StaticResource FieldHint}"/>
                                </StackPanel>
                                <Expander x:Name="MoreSettings" Header="更多设置" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Label Content="显示名称" Target="{Binding ElementName=ProviderName}"/>
                                        <TextBox x:Name="ProviderName" MaxLength="100" Margin="0,0,0,16" AutomationProperties.Name="服务显示名称"/>
                                        <CheckBox x:Name="MakeDefault" Content="设为默认服务" Margin="0,0,0,16"/>
                                        <CheckBox x:Name="ClearKey" Content="删除已保存的密钥" Visibility="Collapsed" Margin="0,0,0,12"/>
                                        <TextBlock Text="密钥加密保存在当前 Windows 账户下。" Style="{StaticResource FieldHint}"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                        <!-- 保存和删除固定在表单下方，滚动或展开设置不遮住主要操作。 -->
                        <Border Grid.Row="2" BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,12,8,0">
                            <StackPanel>
                            <TextBlock x:Name="ConnectionTestResult" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12" Foreground="{DynamicResource ClayMuted}" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"><Button x:Name="TestConnectionButton" Content="测试连接" Click="TestConnection_Click"/><Button x:Name="CancelConnectionTestButton" Content="取消" Click="CancelConnectionTest_Click" Visibility="Collapsed" Margin="8,0,0,0"/></StackPanel>
                                <Button x:Name="DeleteButton" Grid.Column="1" Content="删除" Click="Delete_Click" Visibility="Collapsed" Margin="0,0,10,0"/>
                                <Button x:Name="SaveButton" Grid.Column="2" Content="保存连接" Click="Save_Click" Background="{StaticResource ClayPanelPrimary}" MinWidth="104"/>
                            </Grid>
                            <TextBlock Text="测试发送固定翻译示例，不上传截图；服务商可能计费。" Style="{StaticResource FieldHint}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="应用更新" x:Name="UpdateTab"/>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource ClayMuted}" VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"/>
            <Button x:Name="TermsButton" Grid.Column="1" Content="使用条款" Click="Terms_Click" MinHeight="32" Padding="8,5" Background="Transparent" BorderThickness="0"/>
        </Grid>
    </Grid>
    </Border>
</Window>
