{
  "$meta": {
    "name": "液态共生 v2 · 背景轻移",
    "version": "0.2.0",
    "status": "demo-and-native-integration",
    "units": "CSS px / WPF DIP, seconds; spring mass=1"
  },
  "motion": {
    "direction": "same-as-pointer",
    "desktop": { "x": 18, "y": 12, "k": 100, "c": 22 },
    "atmosphere": { "x": 24, "y": 16, "k": 65, "c": 19 },
    "entry": { "offsetY": 3, "k": 150, "c": 25 },
    "gain": { "default": 1, "min": 0.5, "max": 1.25, "step": 0.05 },
    "edgePadding": 40,
    "sleepFrames": 5
  },
  "rules": {
    "selectionPixels": "fixed",
    "capturePhase": "snap-to-origin",
    "pointerDown": "hold-current-pose",
    "pointerLeave": "spring-to-origin",
    "hiddenOrBlur": "snap-and-sleep",
    "reducedOrEconomyOrCoarsePointer": "static"
  }
}
